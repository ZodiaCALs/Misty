{
  "$description": "Misty design tokens. The source of truth for every platform package. Colours are given at the default hue, 250, in the light appearance; $extensions.org.misty records how each colour follows the hue and its value in the dark appearance.",
  "$extensions": {
    "org.misty": {
      "version": "1.1.0",
      "hue": {
        "default": 250.0,
        "min": 0,
        "max": 360
      },
      "conversion": "OKLCH to sRGB with the OKLab matrices of CSS Color Module Level 4, each channel clipped to 0..1, as browsers do on sRGB displays."
    }
  },
  "parameter": {
    "$description": "The one parameter that every theme colour reads.",
    "hue": {
      "$type": "number",
      "$value": 250.0,
      "$extensions": {
        "org.misty": {
          "css": "--m-hue"
        }
      }
    }
  },
  "font": {
    "$description": "Type stacks. Native platforms use their own interface face instead.",
    "font-sans": {
      "$type": "fontFamily",
      "$value": [
        "-apple-system",
        "BlinkMacSystemFont",
        "SF Pro Text",
        "Segoe UI Variable Text",
        "Segoe UI",
        "system-ui",
        "Roboto",
        "PingFang SC",
        "Hiragino Sans",
        "Microsoft YaHei",
        "Noto Sans CJK SC",
        "sans-serif",
        "Apple Color Emoji",
        "Segoe UI Emoji",
        "Noto Color Emoji"
      ],
      "$extensions": {
        "org.misty": {
          "css": "--m-font-sans"
        }
      }
    },
    "font-mono": {
      "$type": "fontFamily",
      "$value": [
        "ui-monospace",
        "SF Mono",
        "SFMono-Regular",
        "Cascadia Code",
        "Cascadia Mono",
        "Menlo",
        "Monaco",
        "Consolas",
        "Liberation Mono",
        "Courier New",
        "monospace"
      ],
      "$extensions": {
        "org.misty": {
          "css": "--m-font-mono"
        }
      }
    }
  },
